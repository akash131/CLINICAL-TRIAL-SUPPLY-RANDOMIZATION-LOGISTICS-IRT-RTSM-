# Environment Configuration
NODE_ENV=development

# Database
DB_PASSWORD=secure_password_change_in_prod
DATABASE_URL=postgresql://irt_admin:secure_password_change_in_prod@localhost:5432/irt_rtsm_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=change_this_secret_in_production_use_long_random_string
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# API Configuration
PORT=3000
API_VERSION=v1
CORS_ORIGIN=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000

# MinIO Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=irt-rtsm-documents

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Kafka
KAFKA_BROKERS=localhost:9092

# Email Configuration (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=
SMTP_FROM=IRT-RTSM Platform <notifications@example.com>

# SMS Configuration (for IVR/SMS notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AI/ML Services
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Compliance and Audit
ENABLE_AUDIT_LOG=true
AUDIT_RETENTION_DAYS=2555
CFR_PART_11_MODE=true

# Encryption
ENCRYPTION_KEY=change_this_to_32_byte_random_key_for_production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
